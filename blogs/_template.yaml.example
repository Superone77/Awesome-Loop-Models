# Save as: blogs/YYYY-MM-DD-shortname.yaml
# Use this for substantive long-form technical posts about loop models.
# Blogs live in one flat Blogs section. They list the taxonomy sections they discuss
# (see TAXONOMY.md) and use no other taxonomy fields.
#
# `published_date` is required: the post's release date as a quoted
# `YYYY-MM-DD` string, matching the filename. `added_date` (optional) is the
# repo intake date in the same `YYYY-MM-DD` format.

title: "Your Blog Title"
authors:
  - "Author Name"
year: 2026
published_date: "2026-04-21"
added_date: "2026-04-21"
venue: "X Article"   # e.g. X Article, Lab Blog, Substack, Personal Blog

survey_section:      # primary first
  - "architecture/topology"

desc: >
  One concise sentence describing the post's technical value.

links:
  blog: "https://example.com/post"
  github: ""
  project: ""
  twitter: ""
