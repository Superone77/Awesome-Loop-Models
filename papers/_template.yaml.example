# Save as: papers/<arxiv-id>.yaml
# For non-arXiv papers, use a stable slug such as papers/openreview-example.yaml
# For long-form technical blog posts, use blogs/YYYY-MM-DD-shortname.yaml and blogs/_template.yaml.example instead.
#
# Classification follows the Looped Models Survey; see TAXONOMY.md.
# Every taxonomy value is controlled. There are no free-form tags: model and
# method names go in the title and desc. The build rejects category,
# foundation, mechanism_tags, focus_tags, domain_tags and tags.
#
# `published_date` is required: the first public release date as a quoted
# `YYYY-MM-DD` string. `added_date` is the repo intake date, also a quoted
# `YYYY-MM-DD` string; the greatest value defines the `Newly Arrived` batch.

title: "Your Paper Title"
authors:
  - "First Author"
  - "Second Author"
year: 2026
published_date: "2026-04-20"
added_date: "2026-04-20"
venue: "arXiv"

# `must_read: true` is an optional maintainer-only flag (🌟 in README and browser).
# Omit `catalog_fit` for strict scope. A curator may set `catalog_fit: "adjacent"`
# for a rare, labeled exception with primary-source boundary evidence.

survey_section:            # every survey section the paper contributes to; first = primary
  - "architecture/depth-control"
  - "scaling/test-time"
loop_topology: "prelude-core-coda"   # whole-stack | prelude-core-coda | partial | hierarchical | shifted-parallel | implicit-fixed-point | unspecified
sharing: "full"                      # full | partial-adapter | expert-routed | unspecified
depth_control: "sampled-train"       # fixed | sampled-train | adaptive-halting | convergence | unspecified
claims:                              # param-efficiency, compute-efficiency, memory-efficiency, data-efficiency,
  - "test-time-scaling"              # expressivity, length-generalization, test-time-scaling, stability, failure-mode
comparison: []                       # iso-param | iso-flop | iso-depth | unclear; [] if no looped-vs-untied comparison
survey_core: false

desc: >
  One concise sentence describing the paper's core contribution.

links:
  arxiv: "https://arxiv.org/abs/XXXX.XXXXX"
  paper: ""
  github: ""
  hf: ""
  openreview: ""
  project: ""
  comment:
    - label: "Deep-dive thread"
      url: "https://x.com/..."
  twitter: ""
